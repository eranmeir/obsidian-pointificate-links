{
	"name": "pointificate-links",
	"version": "1.0.0",
	"description": "Decode URL-encoded Markdown links and enclose them in pointy brackets, automatically when inserted or on demand.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"markdown",
		"links",
		"commonmark"
	],
	"author": "Eran Meir",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eranmeir/obsidian-pointificate-links.git"
	},
	"homepage": "https://github.com/eranmeir/obsidian-pointificate-links#readme",
	"bugs": {
		"url": "https://github.com/eranmeir/obsidian-pointificate-links/issues"
	},
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
